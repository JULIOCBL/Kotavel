[settings]
os=Windows
compiler=clang
compiler.libcxx=libc++
compiler.cppstd=23
build_type=Debug

[options]
# Kotavel enlaza las bibliotecas TLS; no necesita la utilidad openssl.exe.
# La receta Clang/MinGW omite un helper de Windows al construir esa utilidad.
openssl/*:no_apps=True

[conf]
# Compatibilidad de fmt 11.2 y declaración <atomic> usada sin incluir por Trantor.
tools.build:cxxflags=["-include", "cstdlib", "-include", "atomic", "-D_CRT_RAND_S"]
tools.cmake.cmaketoolchain:generator=Ninja
