# Convierte los objetos JSON anidados en pares clave/texto de C++.
# El binario no necesita los archivos JSON ni un parser en ejecución.
function(kotavel_message_entries json prefix output)
    set(entries "")
    string(JSON count LENGTH "${json}")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON member MEMBER "${json}" ${index})
            if(NOT member MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
                message(FATAL_ERROR "Invalid message key: ${prefix}.${member}")
            endif()
            string(JSON child_type TYPE "${json}" "${member}")
            if(child_type STREQUAL "STRING")
                string(JSON child GET "${json}" "${member}")
                string(FIND "${child}" ")ktv_msg\"" delimiter_position)
                if(NOT delimiter_position EQUAL -1)
                    message(FATAL_ERROR "Reserved raw-string delimiter: ${prefix}.${member}")
                endif()
                string(APPEND entries "    {\"${prefix}.${member}\", R\"ktv_msg(${child})ktv_msg\"},\n")
            elseif(child_type STREQUAL "OBJECT")
                string(JSON child GET "${json}" "${member}")
                kotavel_message_entries("${child}" "${prefix}.${member}" child_entries)
                string(APPEND entries "${child_entries}")
            else()
                message(FATAL_ERROR "Message ${prefix}.${member} must be an object or a string")
            endif()
        endforeach()
    endif()
    set(${output} "${entries}" PARENT_SCOPE)
endfunction()

file(GLOB catalog_files CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/resources/messages/*.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${catalog_files})
set(KOTAVEL_MESSAGE_ENTRIES "")
foreach(catalog_file IN LISTS catalog_files)
    get_filename_component(catalog_name "${catalog_file}" NAME_WE)
    if(NOT catalog_name MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid message catalog name: ${catalog_name}")
    endif()
    file(READ "${catalog_file}" catalog_json)
    string(JSON catalog_type TYPE "${catalog_json}")
    if(NOT catalog_type STREQUAL "OBJECT")
        message(FATAL_ERROR "Message catalog must contain an object: ${catalog_file}")
    endif()
    kotavel_message_entries("${catalog_json}" "${catalog_name}" catalog_entries)
    string(APPEND KOTAVEL_MESSAGE_ENTRIES "${catalog_entries}")
endforeach()
if(KOTAVEL_MESSAGE_ENTRIES STREQUAL "")
    message(FATAL_ERROR "At least one message is required in resources/messages")
endif()
configure_file("${CMAKE_CURRENT_LIST_DIR}/message_catalog.inc.in"
    "${CMAKE_CURRENT_BINARY_DIR}/generated/text/message_catalog.inc" @ONLY)
